# Copy to .env.local and fill in.
# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional: a separate key for the mentor in production (falls back to GEMINI_API_KEY)
# GEMINI_MENTOR_API_KEY=

# Demo key for development and `npm run eval:generator`. Outside production it replaces the keys above.
# GEMINI_API_KEY_DEV=

# Models. The code contains no model names: set these, or the AI stays off.
# MAIN: complex requests and video. LIGHT: short requests and first hints.
GEMINI_MODEL_MAIN=gemini-3.5-flash
GEMINI_MODEL_LIGHT=gemini-flash-lite-latest
# Optional, comma-separated: tried in order when the models above are out of quota or overloaded.
GEMINI_MODEL_FALLBACKS=gemini-flash-latest

# Server only, never public (Supabase → Project Settings → API): AI cache, shared rate limits, usage counters.
# Without it the cache and counters are off and the limits stay in memory.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: public URL for Open Graph links, e.g. https://roboeasy.kz
# NEXT_PUBLIC_SITE_URL=

# Certificates: secret for signing verification codes (16+ characters). Required in production.
# CERT_SECRET=

# Accounts, sync and classes (Supabase). Without these the app stays local-only.
# Local: `npm run db:start` prints both values (API URL and publishable/anon key).
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: show /[lang]/admin in a production build (until admin roles are checked server-side).
# ADMIN_PREVIEW=1

